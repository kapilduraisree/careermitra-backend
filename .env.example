# ============================================================
# CareerMitra AI — Backend Environment Variables
# Copy this file to .env and fill in your values
# NEVER commit .env to version control
# ============================================================

# Server
NODE_ENV=development
PORT=5000

# PostgreSQL Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=careermitra
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here

# JWT Authentication
JWT_SECRET=replace_with_a_long_random_string_minimum_32_chars
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=replace_with_another_long_random_string
JWT_REFRESH_EXPIRES_IN=30d

# ── AI Provider Configuration ─────────────────────────────────────────────────
# Choose one provider: gemini | openai | groq
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash

# Google Gemini (https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI (https://platform.openai.com/api-keys)
OPENAI_API_KEY=your_openai_api_key_here

# Groq (https://console.groq.com)
GROQ_API_KEY=your_groq_api_key_here

# ── File Upload ───────────────────────────────────────────────────────────────
UPLOAD_MAX_MB=5
RESUME_UPLOAD_DIR=uploads/resumes
AVATAR_UPLOAD_DIR=uploads/avatars

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins
ALLOWED_ORIGINS=http://localhost:3000,http://10.0.2.2:5000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# ── Firebase Cloud Messaging (Push Notifications) ────────────────────────────
FCM_SERVER_KEY=your_fcm_server_key_here

# ── Demo Mode ─────────────────────────────────────────────────────────────────
# Set to true to use sample data when AI keys are not configured
DEMO_MODE=true
